# GiroFacile — modello delle impostazioni.
# Copia questo file in .env e compila i valori. Non inserire mai valori veri qui:
# questo file è pubblico nel repository, .env no.
# In produzione (APP_ENV=production) l'app non parte se i valori obbligatori
# mancano o sono deboli: vedi app/core/production_check.py.

# --- Ambiente ---
# development | production
APP_ENV=development
# Indirizzo pubblico HTTPS usato nei link di email, tracking e portali.
APP_BASE_URL=https://app.esempio.it
PUBLIC_BASE_URL=https://esempio.it
GIROFACILE_TIMEZONE=Europe/Rome

# --- Segreti (obbligatori in produzione) ---
# Almeno 32 caratteri casuali, ad esempio: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=
# Valore segreto aggiunto alle password; non cambiarlo dopo la messa online.
PASSWORD_PEPPER=
PASSWORD_PBKDF2_ITERATIONS=260000
# Chiave Fernet per le chiavi dei negozi collegati (Shopify/WooCommerce).
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ORDER_CONNECTOR_KEY=

# --- Super Admin (pannello /admin) ---
SUPERADMIN_USERNAME=
# Almeno 12 caratteri, non una password comune.
SUPERADMIN_PASSWORD=

# --- Database (PostgreSQL) ---
POSTGRES_DB=girofacile
POSTGRES_USER=girofacile
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://girofacile:PASSWORD@localhost:5432/girofacile
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Rete e cookie ---
# In produzione dietro il proxy HTTPS: COOKIE_SECURE=true e TRUST_PROXY_HEADERS=true.
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Docker Compose: l'app ascolta solo in locale, dietro il proxy.
APP_BIND_ADDRESS=127.0.0.1
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=GiroFacile
ERROR_NOTIFICATIONS_ENABLED=true
ERROR_NOTIFICATIONS_EMAIL=
ERROR_NOTIFICATION_MIN_SEVERITY=high

# --- Pagamenti (Stripe) ---
# disabled | test
BILLING_MODE=disabled
BILLING_TEST_USER_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Prove di consegna (firme, foto, PDF) ---
# In produzione serve un bucket S3 privato; l'archivio "local" funziona solo in sviluppo.
OBJECT_STORAGE_ENABLED=false
# s3 | local
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=https://s3.esempio.it
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SIGNED_URL_SECONDS=900
# Solo sviluppo, con OBJECT_STORAGE_BACKEND=local:
OBJECT_STORAGE_LOCAL_PATH=
OBJECT_STORAGE_LOCAL_SECRET=

# --- Percorsi e mappe ---
OSRM_URL=http://localhost:5000
OSRM_ALLOW_PUBLIC_FALLBACK=false
NOMINATIM_URL=
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_ENABLED=false
GOOGLE_ROUTES_ENABLED=false
# none | mapbox
TRAFFIC_PROVIDER=none
MAPBOX_ACCESS_TOKEN=
# 0 = cache senza scadenza
DISTANCE_CACHE_TTL_DAYS=0

# --- Ordini via email (in sviluppo, non attivo) ---
ORDER_INBOUND_ADDRESS=
ORDER_INBOUND_PASSWORD=

# --- Ricerca targa ---
# free | mycarplate | openapi
VEHICLE_LOOKUP_PROVIDER=free
MYCARPLATE_API_KEY=
OPENAPI_AUTOMOTIVE_TOKEN=

# --- Assistente AI (facoltativo) ---
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Backup ---
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
